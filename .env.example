# ==============================================================================
# Py2Java Edu — Variables de Entorno (.env.example)
# Copia este archivo como `.env` y completa los valores reales antes de iniciar.
# Nunca subas el archivo `.env` real al repositorio.
# ==============================================================================

# --- Seguridad y entorno de Flask ---
# Clave secreta para firmar sesiones y códigos HMAC de certificados.
# OBLIGATORIA en producción (mínimo 32 caracteres aleatorios).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_secreta_segura_de_64_caracteres

# Entorno de ejecución (`development` o `production`).
# En Vercel se activa automáticamente el modo producción.
FLASK_ENV=development

# Modo depuración local (NUNCA activar en producción; por defecto false).
FLASK_DEBUG=false

# Nivel de logging estructurado en UTC (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Zona horaria de referencia para rachas diarias y fechas de reportes PDF/CSV.
APP_TIMEZONE=America/Bogota

# --- Base de datos (PostgreSQL / SQLite) ---
# En producción usa PostgreSQL (ej. Supabase Transaction/Session Pooler con sslmode=require).
# Si se deja comentado o vacío en local, usa SQLite automáticamente (database_v2.sqlite).
# DATABASE_URL=postgresql://usuario:password@host.pooler.supabase.com:6543/postgres?sslmode=require

# --- Rate Limiting (Flask-Limiter) ---
# En desarrollo usa `memory://`. En producción multi-instancia se recomienda Redis (`redis://...`).
RATELIMIT_STORAGE_URI=memory://

# --- Cuentas administrativas y registro docente ---
# Código secreto opcional para auto-registro de profesores en /register.
# El Super Admin también puede crear cuentas docentes directamente desde /superadmin.
TEACHER_SECRET_CODE=codigo_secreto_profesor

# Bootstrap inicial opcional de Super Admin (se aplica solo si no existe ningún superadmin).
# También puedes crear uno en cualquier momento con: flask --app app create-superadmin
# SUPERADMIN_USERNAME=superadmin
# SUPERADMIN_EMAIL=superadmin@dominio.edu
# SUPERADMIN_PASSWORD=CambiaEstaClaveSegura123

# --- Tutor IA (Google Gemini) ---
# Clave de API de Google Gemini para el Tutor IA en el Laboratorio de Práctica.
GEMINI_API_KEY=tu_api_key_de_gemini

# --- Correo electrónico para recuperación de contraseña (OTP) ---
# Elige OPCIÓN A (SMTP) o OPCIÓN B (Resend API HTTPS).

# OPCIÓN A — SMTP sobre IPv4 (ej. Gmail con Verificación en 2 pasos + Contraseña de Aplicación)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_password_de_aplicacion_16_chars
MAIL_DEFAULT_SENDER=Py2Java Edu <tu_correo@gmail.com>

# OPCIÓN B — Resend API (HTTPS, recomendada en entornos serverless)
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_DEFAULT_SENDER=Py2Java Edu <onboarding@resend.dev>

# Modo demo de recuperación sin proveedor de correo.
# Por defecto `false` y estrictamente prohibido en producción/Vercel.
ALLOW_DEMO_RESET=false
