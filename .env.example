# Clave secreta para firmar sesiones de Flask (OBLIGATORIA en producción, mínimo 32 caracteres)
SECRET_KEY=cambia_esto_por_una_clave_secreta_segura_de_64_caracteres

# Modo depuración local (nunca activar en producción; por defecto false)
FLASK_DEBUG=false

# Nivel de logging estructurado (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Zona horaria de referencia para cálculo de rachas diarias y fechas de reportes (evita cortes de racha en LATAM)
APP_TIMEZONE=America/Bogota

# Base de datos PostgreSQL (ej. Supabase Session/Transaction Pooler)
# Si se deja vacío en local, usará SQLite automáticamente (database_v2.sqlite)
DATABASE_URL=postgresql://usuario:password@host.pooler.supabase.com:6543/postgres?sslmode=require

# Almacenamiento para Flask-Limiter (memory:// en desarrollo; Redis recomendado en producción multi-instancia)
# RATELIMIT_STORAGE_URI=memory://

# Bootstrap inicial de Super Admin (se aplica SOLO si aún no existe ningún usuario superadmin en la BD)
# También puedes crear uno en cualquier momento ejecutando: flask create-superadmin
# SUPERADMIN_USERNAME=superadmin
# SUPERADMIN_EMAIL=superadmin@dominio.edu
# SUPERADMIN_PASSWORD=CambiaEstaClaveSegura123

# Clave de API de Google Gemini para el Tutor IA
GEMINI_API_KEY=tu_api_key_de_gemini

# Código secreto requerido para registrar cuentas con rol de Profesor
TEACHER_SECRET_CODE=codigo_secreto_profesor

# Envío de correos reales para recuperación de contraseña (elige OPCIÓN A o OPCIÓN B):
# OPCIÓN A — Gmail SMTP (requiere Verificación en 2 pasos + Contraseña de Aplicación de 16 caracteres)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_password_de_aplicacion_16_chars
MAIL_DEFAULT_SENDER=Py2Java Edu <tu_correo@gmail.com>

# OPCIÓN B — Resend API (HTTPS, alternativa recomendada en serverless si no usas SMTP)
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_DEFAULT_SENDER=Py2Java Edu <onboarding@resend.dev>

# Modo demo de recuperación sin SMTP (por defecto false; estrictamente prohibido en producción/Vercel)
ALLOW_DEMO_RESET=false
